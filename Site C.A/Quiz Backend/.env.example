# Main backend local development. Do not put real secrets in this file or commit a .env file.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string for the main Competence Academy database.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<ATLAS_CLUSTER_HOST>/competence_academy?retryWrites=true&w=majority

# Frontend origins allowed to call this API.
FRONTEND_URLS=http://127.0.0.1:5500,http://localhost:5500,https://competenceacademy.netlify.app

# Generate strong random secrets. ADMIN_JWT_SECRET must match the Quiz Backend value.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes-shared-with-quiz-backend

# Three comma-separated admin email addresses; keep the list identical on both services.
ALLOWED_ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com

# Required Google OAuth client ID.
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Configure one email provider:
# Brevo:
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Or Resend:
RESEND_API_KEY=
EMAIL_FROM=
# Or SMTP:
EMAIL_USER=
EMAIL_PASS=
# Used for access-approval messages if SMTP is not configured.
ACCESS_APPROVAL_EMAIL=

# Tranzak.co API key and webhook secret. Configure the webhook and the public
# Cours en Ligne page as the return URL in the Tranzak dashboard:
# https://site-competence-academy-backend.onrender.com/api/tranzak-webhook
TRANZAK_API_URL=https://api.tranzak.co
TRANZAK_API_KEY=
TRANZAK_WEBHOOK_SECRET=
