# Local development only. Do not put real secrets in this file or commit a .env file.
PORT=5100
NODE_ENV=development

# Render service Root Directory: Site C.A/Quiz Backend (do not select Site C.A).
# Use the complete MongoDB Atlas connection string for the quiz database.
# Replace every placeholder before adding it to Render Environment Variables.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<ATLAS_CLUSTER_HOST>/competence_academy_quiz?retryWrites=true&w=majority

# Comma-separated origins allowed to call the quiz API.
FRONTEND_URLS=http://127.0.0.1:5500,http://localhost:5500,https://competenceacademy.netlify.app

# Configure both variables with exactly the same values in the main backend
# and this Quiz Backend Render service. The email list must contain 3 addresses.
ALLOWED_ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com
# Generate at least 32 random bytes and use the identical secret in both services.
ADMIN_JWT_SECRET=replace-with-at-least-32-random-bytes-shared-with-main-backend
