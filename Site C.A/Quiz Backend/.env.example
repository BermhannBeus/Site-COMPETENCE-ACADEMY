# Local development only. Do not put real secrets in this file or commit a .env file.
PORT=5100
NODE_ENV=development

# Use the complete MongoDB Atlas connection string for the quiz database.
# Replace every placeholder before adding it to Render Environment Variables.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<ATLAS_CLUSTER_HOST>/competence_academy_quiz?retryWrites=true&w=majority

# Comma-separated origins allowed to call the quiz API.
FRONTEND_URLS=http://127.0.0.1:5500,http://localhost:5500,https://competenceacademy.netlify.app
